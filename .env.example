# ---------------------------------------------------------------------------
# SPECTRA configuration. Copy to .env and fill in real values.
# With an empty DATABASE_URL the app uses a local SQLite file so the demo runs
# without any cloud account.
# ---------------------------------------------------------------------------

# --- Supabase (managed Postgres) -------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
# service-role key is only used server-side for Storage uploads
SUPABASE_SERVICE_KEY=
# JWT secret from Supabase project settings (Auth -> JWT settings) -- used when AUTH_MODE=jwt
SUPABASE_JWT_SECRET=
# Postgres connection string (Project settings -> Database -> Connection string / URI)
DATABASE_URL=

# "local" (files under data/uploads) or "supabase" (Storage bucket spectra-evidence)
STORAGE_MODE=local

# --- auth -------------------------------------------------------------------
# open = demo (every request is an analyst) | jwt = verify Supabase Auth tokens
AUTH_MODE=open

# --- Telegram collector (read-only public channels) ------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BATCH_SIZE=100
TELEGRAM_MAX_MESSAGES=500

# --- ML ---------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
WHISPER_MODEL=base
ENABLE_EMBEDDINGS=true
ENABLE_EASYOCR=true
OCR_LANGS=en,hi

# --- frontend ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
