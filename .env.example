# ---------------------------------------------------------------------------
# SPECTRA configuration. Copy to .env (repo root) and fill in real values.
# Empty DATABASE_URL -> local SQLite (demo). Set Postgres for production.
# ---------------------------------------------------------------------------

# --- database / storage (optional; SQLite is fine for the demo) -------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
STORAGE_MODE=local            # local | supabase
AUTH_MODE=open                # open (demo) | jwt (Supabase Auth)

# --- Telegram user session (needed to JOIN and READ public channels) --------
# https://my.telegram.org -> API development tools -> App api_id / api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Leave empty; `python scripts/telegram_login.py` writes .telegram_session/spectra.session
TELEGRAM_SESSION=
TELEGRAM_BATCH_SIZE=100
TELEGRAM_MAX_MESSAGES=500

# --- Telegram bot (notifications + /status /alerts /join /scan) -------------
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=
# Optional: your chat id. Analysts can also send /start to subscribe.
TELEGRAM_BOT_CHAT_ID=

# --- auto-join + auto-pilot -------------------------------------------------
AUTO_JOIN_ENABLED=true
AUTO_JOIN_KEYWORDS=ganja,charas,mdma,weed,heroin,cocaine,katta,tamancha,pistol,ammo,mule account,account kiraye,atm card,net banking kit,fake aadhaar
AUTO_PILOT_ENABLED=true
AUTO_PILOT_INTERVAL=900       # seconds between monitoring sweeps
AUTO_PILOT_BATCH=40           # messages fetched per channel per sweep

# --- LLM scanner (BharatCode, OpenAI-compatible) ---------------------------
# Key: https://bharatcode.ai/account -> Developer API
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=glm-5.3-flash
LLM_ENABLED=true
LLM_TIMEOUT=120
LLM_MAX_CONCURRENCY=2

# --- ML / OCR ---------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
WHISPER_MODEL=base
ENABLE_EMBEDDINGS=true
ENABLE_EASYOCR=true
OCR_LANGS=en,hi

# --- frontend / CORS --------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000,http://127.0.0.1:8000
